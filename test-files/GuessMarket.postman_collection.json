{
  "info": {
    "name": "Guess Market Server",
    "description": "End-to-end tests of the Guess Market server.\nBefore every run: restart Tomcat - the server keeps its data only in memory, so a restart gives a clean state.\nUpload requests read multiple.xml from Postman's working directory (Settings > General > Working Directory = the project's test-files folder).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080/GuessMarket"
    }
  ],
  "item": [
    {
      "name": "00 Cleanup - log out a leftover session",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"logged out, or was not logged in\", () => pm.expect([200, 401]).to.include(pm.response.code));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/logout",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "logout"
          ]
        }
      }
    },
    {
      "name": "01 Ping (fresh server)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"status is 200\", () => pm.response.to.have.status(200));",
              "const body = pm.response.json();",
              "pm.test(\"server is OK\", () => pm.expect(body.status).to.eql(\"OK\"));",
              "pm.test(\"fresh server has no events (restart Tomcat before running)\", () => pm.expect(body.events).to.eql(0));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/ping",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "ping"
          ]
        }
      }
    },
    {
      "name": "02 POST to ping -> 405",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"status is 405\", () => pm.response.to.have.status(405));",
              "pm.test(\"error mentions: POST is not supported\", () => pm.expect(pm.response.json().error).to.include(\"POST is not supported\"));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/ping",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "ping"
          ]
        }
      }
    },

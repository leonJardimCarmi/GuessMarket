<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="500.0" minWidth="800.0" prefHeight="650.0" prefWidth="1200.0" styleClass="style.css" stylesheets="@style.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.guessmarket.ui.MainController">
    <!-- Top Bar: Load XML, File Path, Progress, Save/Load State, Create Event, Theme Selector -->
    <top>
        <HBox alignment="CENTER_LEFT" prefHeight="60.0" prefWidth="1200.0" spacing="10.0" BorderPane.alignment="CENTER">
            <children>
                <Button fx:id="loadFileButton" mnemonicParsing="false" onAction="#onLoadFileButtonClicked" text="Load File">
                    <HBox.margin>
                        <Insets left="10.0" />
                    </HBox.margin>
                </Button>
                <TextField fx:id="filePathTextField" editable="false" onMouseClicked="#onFilePathTextFieldClicked" prefHeight="25.0" prefWidth="280.0" promptText="To load file click here " />
                <ProgressBar fx:id="loadProgressBar" prefWidth="120.0" progress="0.0" visible="false">
                    <HBox.margin>
                        <Insets left="5.0" />
                    </HBox.margin>
                </ProgressBar>

                <Button mnemonicParsing="false" onAction="#onSaveStateButtonClicked" text="Save State">
                    <HBox.margin>
                        <Insets left="10.0" />
                    </HBox.margin>
                </Button>
                <Button mnemonicParsing="false" onAction="#onLoadStateButtonClicked" text="Load State" />

                <!-- Bonus 2: Button to trigger new Event creation dialog -->
                <Button mnemonicParsing="false" onAction="#onCreateEventButtonClicked" style="-fx-base: #17a2b8; -fx-text-fill: white; -fx-font-weight: bold;" text="+ Create Event">
                    <HBox.margin>
                        <Insets left="10.0" />
                    </HBox.margin>
                </Button>

                <!-- Bonus 1: Dynamic Theme Selector -->
                <Label style="-fx-font-weight: bold;" text="Theme:">
                    <HBox.margin>
                        <Insets left="15.0" />
                    </HBox.margin>
                </Label>
                <ComboBox fx:id="themeComboBox" prefWidth="110.0" promptText="Default" />
            </children>
            <padding>
                <Insets bottom="10.0" top="10.0" />
            </padding>
        </HBox>
    </top>

    <!-- Center: Main TabPane dividing Events and Users -->
    <center>
        <TabPane fx:id="mainTabPane" tabClosingPolicy="UNAVAILABLE" BorderPane.alignment="CENTER">
            <tabs>
                <!-- ==================== TAB 1: EVENTS ==================== -->
                <Tab text="Events">
                    <content>
                        <SplitPane dividerPositions="0.35" prefHeight="510.0" prefWidth="1200.0">
                            <items>
                                <!-- Left Panel: Filters & Events List -->
                                <VBox spacing="10.0">
                                    <padding>
                                        <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
                                    </padding>
                                    <children>
                                        <HBox alignment="CENTER_LEFT" spacing="8.0">
                                            <children>
                                                <Label text="Method:" />
                                                <ComboBox fx:id="filterMethodComboBox" prefWidth="90.0" promptText="All" />
                                                <Label text="Status:" />
                                                <ComboBox fx:id="filterStatusComboBox" prefWidth="80.0" promptText="All" />
                                                <Label text="MM:" />
                                                <ComboBox fx:id="filterMarketMakerComboBox" prefWidth="85.0" promptText="All" />
                                            </children>
                                        </HBox>
                                        <TableView fx:id="eventsTableView" VBox.vgrow="ALWAYS">
                                            <columns>
                                                <TableColumn fx:id="eventIdColumn" prefWidth="70.0" text="Event ID" />
                                                <TableColumn fx:id="eventTitleColumn" prefWidth="140.0" text="Title" />
                                                <TableColumn fx:id="eventMethodColumn" prefWidth="90.0" text="Method" />
                                                <TableColumn fx:id="eventStatusColumn" prefWidth="60.0" text="Active" />
                                            </columns>
                                            <columnResizePolicy>
                                                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                                            </columnResizePolicy>
                                        </TableView>
                                    </children>
                                </VBox>

                                <ScrollPane fitToHeight="true" fitToWidth="true">
                                    <content>
                                        <VBox spacing="10.0">
                                            <padding>
                                                <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
                                            </padding>
                                            <children>
                                                <HBox alignment="CENTER_LEFT" spacing="10.0">
                                                    <children>
                                                        <VBox HBox.hgrow="ALWAYS">
                                                            <children>
                                                                <Label style="-fx-font-size: 11px; -fx-text-fill: #666;" text="Selected Event:" />
                                                                <Label fx:id="eventNameLabel" style="-fx-font-weight: bold; -fx-font-size: 16px;" text="No Event Selected" />
                                                            </children>
                                                        </VBox>
                                                        <Button mnemonicParsing="false" onAction="#onExecuteTradeButtonClicked" style="-fx-base: #28a745; -fx-text-fill: white; -fx-font-weight: bold;" text="Execute Trade" />
                                                        <Button mnemonicParsing="false" onAction="#onCloseEventButtonClicked" style="-fx-base: #dc3545; -fx-text-fill: white; -fx-font-weight: bold;" text="Close Event" />
                                                    </children>
                                                </HBox>

                                                <!-- Order Book Statistics Bar -->
                                                <HBox alignment="CENTER" spacing="15.0" style="-fx-background-color: #f0f0f0; -fx-padding: 8px; -fx-border-color: #ccc; -fx-border-radius: 4px;">
                                                    <children>
                                                        <Label text="LAST:" /><Label fx:id="lastPriceLabel" style="-fx-font-weight: bold;" text="-" />
                                                        <Label text="BID:" /><Label fx:id="bidPriceLabel" style="-fx-font-weight: bold; -fx-text-fill: #28a745;" text="-" />
                                                        <Label text="ASK:" /><Label fx:id="askPriceLabel" style="-fx-font-weight: bold; -fx-text-fill: #dc3545;" text="-" />
                                                        <Label text="MID:" /><Label fx:id="midPriceLabel" style="-fx-font-weight: bold;" text="-" />
                                                        <Label text="SPREAD:" /><Label fx:id="spreadLabel" style="-fx-font-weight: bold;" text="-" />
                                                    </children>
                                                </HBox>

                                                <!-- LMSR Info Display -->
                                                <ScrollPane fx:id="lmsrInfoScrollPane" fitToWidth="true" managed="false" minHeight="200.0" prefHeight="260.0" style="-fx-background-color: transparent;" visible="false">
                                                    <content>
                                                        <Label fx:id="lmsrInfoLabel" maxWidth="1.26443019807E30" style="-fx-background-color: #eef7ff; -fx-padding: 12px; -fx-border-color: #bce0fd; -fx-border-radius: 4px; -fx-font-size: 14px; -fx-line-spacing: 4px;" wrapText="true" />
                                                    </content>
                                                </ScrollPane>

                                                <!-- Order Book Tables Container -->
                                                <HBox fx:id="orderBookTablesContainer" prefHeight="300.0" spacing="10.0" VBox.vgrow="ALWAYS">
                                                    <children>
                                                        <VBox HBox.hgrow="ALWAYS">
                                                            <children>
                                                                <Label alignment="CENTER" maxWidth="1.26443019807E30" style="-fx-font-weight: bold; -fx-text-fill: #28a745;" text="Buy Orders (Bids)" />
                                                                <TableView fx:id="option1TableView" VBox.vgrow="ALWAYS">
                                                                    <columns>
                                                                        <TableColumn fx:id="opt1UserColumn" prefWidth="80.0" text="User" />
                                                                        <TableColumn fx:id="opt1OutcomeColumn" prefWidth="80.0" text="Outcome" />
                                                                        <TableColumn fx:id="opt1SharesColumn" prefWidth="60.0" text="Shares" />
                                                                        <TableColumn fx:id="opt1PriceColumn" prefWidth="60.0" text="Price" />
                                                                    </columns>
                                                                    <columnResizePolicy>
                                                                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                                                                    </columnResizePolicy>
                                                                </TableView>
                                                            </children>
                                                        </VBox>
                                                        <VBox HBox.hgrow="ALWAYS">
                                                            <children>
                                                                <Label alignment="CENTER" maxWidth="1.26443019807E30" style="-fx-font-weight: bold; -fx-text-fill: #dc3545;" text="Sell Orders (Asks)" />
                                                                <TableView fx:id="option2TableView" VBox.vgrow="ALWAYS">
                                                                    <columns>
                                                                        <TableColumn fx:id="opt2UserColumn" prefWidth="80.0" text="User" />
                                                                        <TableColumn fx:id="opt2OutcomeColumn" prefWidth="80.0" text="Outcome" />
                                                                        <TableColumn fx:id="opt2SharesColumn" prefWidth="60.0" text="Shares" />
                                                                        <TableColumn fx:id="opt2PriceColumn" prefWidth="60.0" text="Price" />
                                                                    </columns>
                                                                    <columnResizePolicy>
                                                                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                                                                    </columnResizePolicy>
                                                                </TableView>
                                                            </children>
                                                        </VBox>
                                                    </children>
                                                </HBox>

                                                <!-- Participations Table -->
                                                <VBox prefHeight="180.0" VBox.vgrow="ALWAYS">
                                                    <children>
                                                        <Label alignment="CENTER" maxWidth="1.26443019807E30" style="-fx-font-weight: bold;" text="Trade History / Participations" />
                                                        <TableView fx:id="participationsTableView" VBox.vgrow="ALWAYS">
                                                            <columns>
                                                                <TableColumn fx:id="partUserColumn" prefWidth="120.0" text="User" />
                                                                <TableColumn fx:id="partOutcomeColumn" prefWidth="120.0" text="Outcome" />
                                                                <TableColumn fx:id="partPriceColumn" prefWidth="100.0" text="Total Paid" />
                                                            </columns>
                                                            <columnResizePolicy>
                                                                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                                                            </columnResizePolicy>
                                                        </TableView>
                                                    </children>
                                                </VBox>
                                            </children>
                                        </VBox>
                                    </content>
                                </ScrollPane>
                            </items>
                        </SplitPane>
                    </content>
                </Tab>

                <!-- ==================== TAB 2: USERS ==================== -->
                <Tab text="Users">
                    <content>
                        <SplitPane dividerPositions="0.3" prefHeight="510.0" prefWidth="1200.0">
                            <items>
                                <!-- Left Panel: Users List & Add User Action -->
                                <VBox spacing="10.0">
                                    <padding>
                                        <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
                                    </padding>
                                    <children>
                                        <HBox alignment="CENTER_LEFT" spacing="10.0">
                                            <children>
                                                <Label style="-fx-font-weight: bold;" text="Users List" HBox.hgrow="ALWAYS" />
                                                <!-- Bonus 3: Add User Button -->
                                                <Button mnemonicParsing="false" onAction="#onAddUserButtonClicked" style="-fx-base: #28a745; -fx-text-fill: white; -fx-font-weight: bold;" text="+ Add User" />
                                            </children>
                                        </HBox>
                                        <TableView fx:id="usersTableView" VBox.vgrow="ALWAYS">
                                            <columns>
                                                <TableColumn fx:id="userNameColumn" prefWidth="150.0" text="Username" />
                                                <TableColumn fx:id="userBalanceColumn" prefWidth="120.0" text="Balance" />
                                            </columns>
                                            <columnResizePolicy>
                                                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                                            </columnResizePolicy>
                                        </TableView>
                                    </children>
                                </VBox>

                                <!-- Right Panel: Single User Details & Holdings -->
                                <VBox spacing="15.0">
                                    <padding>
                                        <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
                                    </padding>
                                    <children>
                                        <HBox alignment="CENTER_LEFT" spacing="20.0" style="-fx-background-color: #f9f9f9; -fx-padding: 12px; -fx-border-color: #e0e0e0; -fx-border-radius: 5px;">
                                            <children>
                                                <VBox HBox.hgrow="ALWAYS">
                                                    <children>
                                                        <Label style="-fx-font-size: 11px; -fx-text-fill: #666;" text="Selected User Details" />
                                                        <Label fx:id="selectedUserTitleLabel" style="-fx-font-weight: bold; -fx-font-size: 16px;" text="No User Selected" />
                                                    </children>
                                                </VBox>
                                                <Button mnemonicParsing="false" onAction="#onDepositButtonClicked" style="-fx-base: #007bff; -fx-text-fill: white; -fx-font-weight: bold;" text="Deposit Funds" />
                                            </children>
                                        </HBox>

                                        <Label style="-fx-font-weight: bold; -fx-font-size: 14px;" text="Events Participation / Owner &amp; Holdings" />

                                        <TableView fx:id="userHoldingsTableView" VBox.vgrow="ALWAYS">
                                            <columns>
                                                <TableColumn fx:id="userHoldingsEventIdColumn" prefWidth="80.0" text="Event ID" />
                                                <TableColumn fx:id="userHoldingsOutcomeColumn" prefWidth="120.0" text="Outcome" />
                                                <TableColumn fx:id="userHoldingsSharesColumn" prefWidth="80.0" text="Shares" />
                                                <TableColumn fx:id="userHoldingsPriceColumn" prefWidth="90.0" text="Paid" />
                                                <TableColumn fx:id="userHoldingsFeeColumn" prefWidth="80.0" text="Fee" />
                                                <TableColumn fx:id="userHoldingsStatusColumn" prefWidth="100.0" text="Status" />
                                                <TableColumn fx:id="userHoldingsPnLColumn" prefWidth="90.0" text="P&amp;L" />
                                            </columns>
                                            <columnResizePolicy>
                                                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                                            </columnResizePolicy>
                                        </TableView>
                                    </children>
                                </VBox>
                            </items>
                        </SplitPane>
                    </content>
                </Tab>
            </tabs>
        </TabPane>
    </center>

    <!-- Bottom: Status Bar for application state notifications -->
    <bottom>
        <HBox alignment="CENTER_LEFT" prefHeight="25.0" prefWidth="1200.0" style="-fx-background-color: #f4f4f4; -fx-border-color: #cccccc; -fx-border-width: 1 0 0 0;" BorderPane.alignment="CENTER">
            <children>
                <Label fx:id="statusLabel" text="Ready">
                    <HBox.margin>
                        <Insets left="10.0" />
                    </HBox.margin>
                </Label>
            </children>
        </HBox>
    </bottom>
</BorderPane>
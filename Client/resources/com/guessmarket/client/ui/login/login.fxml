<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" spacing="16" xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.guessmarket.client.ui.login.LoginController">
    <padding>
        <Insets top="24" right="24" bottom="24" left="24"/>
    </padding>

    <Label text="Guess Market" styleClass="title"/>

    <!-- The status can be a long message: it wraps to more lines instead of being cut -->
    <VBox alignment="CENTER" spacing="2">
        <Label fx:id="serverStatusLabel" text="Checking the server..." wrapText="true" textAlignment="CENTER"
               maxWidth="420"/>
        <Hyperlink text="Check again" onAction="#onCheckServer"/>
    </VBox>

    <HBox alignment="CENTER" spacing="8">
        <TextField fx:id="userNameField" promptText="Your name" prefColumnCount="18" onAction="#onLogin"/>
        <Button fx:id="loginButton" text="Log in" defaultButton="true" onAction="#onLogin"/>
    </HBox>

    <Label fx:id="errorLabel" styleClass="error-text" wrapText="true" maxWidth="420"/>
</VBox>

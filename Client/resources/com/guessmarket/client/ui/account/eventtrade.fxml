<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ChoiceBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<!-- One event from the logged-in user's side: their position in it, and the actions they may take. -->
<VBox spacing="10" xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.guessmarket.client.ui.account.EventTradeController">

    <HBox alignment="CENTER_LEFT" spacing="8">
        <Label text="Event:"/>
        <ComboBox fx:id="eventChoice" promptText="Choose an event" prefWidth="260"/>
    </HBox>

    <Label fx:id="chooseHint" text="Choose an event to see your position in it and to trade." wrapText="true"/>

    <VBox fx:id="detailsBox" spacing="10">
        <FlowPane fx:id="factsPane" hgap="10" vgap="10"/>

        <!-- ===== Actions: only the ones that fit the event's state and the user's role are shown ===== -->
        <VBox fx:id="actionsBox" spacing="8" styleClass="actions-box">
            <FlowPane fx:id="openBox" hgap="8" vgap="6" alignment="CENTER_LEFT">
                <Button text="Open event" onAction="#onOpen"/>
                <Label text="You are the market maker: opening starts the trading and pays the event's opening funds."
                       wrapText="true"/>
            </FlowPane>

            <FlowPane fx:id="buyBox" hgap="8" vgap="6" alignment="CENTER_LEFT">
                <Label text="Buy" styleClass="section-title"/>
                <ChoiceBox fx:id="buyOutcomeChoice"/>
                <Label text="Shares:"/>
                <TextField fx:id="buySharesField" prefColumnCount="6" onAction="#onBuy"/>
                <Button text="Buy" onAction="#onBuy"/>
            </FlowPane>

            <FlowPane fx:id="orderBox" hgap="8" vgap="6" alignment="CENTER_LEFT">
                <Label text="Order" styleClass="section-title"/>
                <ChoiceBox fx:id="sideChoice"/>
                <ChoiceBox fx:id="orderOutcomeChoice"/>
                <Label text="Shares:"/>
                <TextField fx:id="orderSharesField" prefColumnCount="6"/>
                <Label fx:id="priceLabel" text="Price:"/>
                <TextField fx:id="priceField" prefColumnCount="5" onAction="#onPlaceOrder"/>
                <Button text="Place order" onAction="#onPlaceOrder"/>
            </FlowPane>

            <FlowPane fx:id="closeBox" hgap="8" vgap="6" alignment="CENTER_LEFT">
                <Label text="Close" styleClass="section-title"/>
                <Label text="Winner:"/>
                <ChoiceBox fx:id="winnerChoice"/>
                <Button text="Close event" onAction="#onClose"/>
            </FlowPane>

            <Label fx:id="noActionsLabel" wrapText="true"/>
            <Label fx:id="actionMessage" wrapText="true"/>
        </VBox>

        <Label text="My holdings" styleClass="section-title"/>
        <TableView fx:id="holdingsTable" prefHeight="110" minHeight="90">
            <columns>
                <TableColumn fx:id="holdingOutcomeColumn" text="Outcome"/>
                <TableColumn fx:id="holdingSharesColumn" text="Shares"/>
                <TableColumn fx:id="holdingPaidColumn" text="Paid for them"/>
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
            </columnResizePolicy>
        </TableView>

        <VBox fx:id="openOrdersBox" spacing="6">
            <Label text="My waiting orders" styleClass="section-title"/>
            <TableView fx:id="openOrdersTable" prefHeight="120" minHeight="90">
                <columns>
                    <TableColumn fx:id="orderSideColumn" text="Side"/>
                    <TableColumn fx:id="orderOutcomeColumn" text="Outcome"/>
                    <TableColumn fx:id="orderSharesColumn" text="Shares left"/>
                    <TableColumn fx:id="orderPriceColumn" text="Price"/>
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                </columnResizePolicy>
                <placeholder>
                    <Label text="No waiting orders"/>
                </placeholder>
            </TableView>
        </VBox>

        <Label text="My trades (newest first)" styleClass="section-title"/>
        <TableView fx:id="tradesTable" prefHeight="150" minHeight="90">
            <columns>
                <TableColumn fx:id="tradeActionColumn" text="Action"/>
                <TableColumn fx:id="tradeOutcomeColumn" text="Outcome"/>
                <TableColumn fx:id="tradeSharesColumn" text="Shares"/>
                <TableColumn fx:id="tradeAmountColumn" text="Amount"/>
                <TableColumn fx:id="tradeFeeColumn" text="Fee"/>
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
            </columnResizePolicy>
            <placeholder>
                <Label text="No trades yet"/>
            </placeholder>
        </TableView>
    </VBox>
</VBox>

<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<SplitPane dividerPositions="0.36" xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
           fx:controller="com.guessmarket.client.ui.account.AccountController">

    <!-- ===== Left: uploading an events file, and the other users ===== -->
    <VBox spacing="8" minWidth="200">
        <padding>
            <Insets top="10" right="10" bottom="10" left="10"/>
        </padding>

        <Label text="Upload events file" styleClass="section-title"/>
        <HBox spacing="6" alignment="CENTER_LEFT">
            <TextField fx:id="filePathField" editable="false" promptText="Click to choose an XML file"
                       onMouseClicked="#onBrowse" HBox.hgrow="ALWAYS"/>
            <Button text="Browse..." minWidth="-Infinity" onAction="#onBrowse"/> <!-- the path field shrinks instead -->
        </HBox>
        <HBox spacing="8" alignment="CENTER_LEFT">
            <Button fx:id="uploadButton" text="Upload" disable="true" onAction="#onUpload"/>
            <ProgressIndicator fx:id="uploadProgress" prefWidth="22" prefHeight="22" visible="false"/>
        </HBox>
        <Label fx:id="uploadMessage" wrapText="true"/>

        <HBox alignment="CENTER_LEFT" spacing="8">
            <padding>
                <Insets top="8"/>
            </padding>
            <Label text="Users" styleClass="section-title"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="Refresh" onAction="#onRefresh"/>
        </HBox>
        <TableView fx:id="usersTable" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="userNameColumn" text="User"/>
                <TableColumn fx:id="userBalanceColumn" text="Balance"/>
                <TableColumn fx:id="userMarketMakerColumn" text="Market maker"/>
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
            </columnResizePolicy>
        </TableView>
    </VBox>

    <!-- ===== Right: the user's own account (scrolls when the window is small) ===== -->
    <ScrollPane fitToWidth="true" minWidth="150">
        <VBox spacing="12">
            <padding>
                <Insets top="10" right="10" bottom="10" left="10"/>
            </padding>

            <Label text="My account" styleClass="section-title"/>
            <FlowPane fx:id="balancePane" hgap="10" vgap="10"/>
            <FlowPane hgap="8" vgap="6" alignment="CENTER_LEFT">
                <Label text="Deposit:"/>
                <TextField fx:id="depositField" promptText="Amount" prefColumnCount="8" onAction="#onDeposit"/>
                <Button fx:id="depositButton" text="Deposit" onAction="#onDeposit"/>
            </FlowPane>
            <Label fx:id="depositMessage" wrapText="true"/>

            <Label text="My events (click one to see it below)" styleClass="section-title"/>
            <TableView fx:id="myEventsTable" prefHeight="140" minHeight="100">
                <columns>
                    <TableColumn fx:id="myEventNameColumn" text="Event"/>
                    <TableColumn fx:id="myEventRoleColumn" text="My role"/>
                    <TableColumn fx:id="myEventStatusColumn" text="Status"/>
                    <TableColumn fx:id="myEventMethodColumn" text="Method"/>
                    <TableColumn fx:id="myEventSharesColumn" text="My shares"/>
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                </columnResizePolicy>
                <placeholder>
                    <Label text="No events yet: upload a file to become a market maker, or trade in an event below."
                           wrapText="true"/>
                </placeholder>
            </TableView>

            <Label text="Event details and trading" styleClass="section-title"/>
            <fx:include fx:id="eventTrade" source="/com/guessmarket/client/ui/account/eventtrade.fxml"/>

            <Label text="Account history (newest first)" styleClass="section-title"/>
            <TableView fx:id="ledgerTable" prefHeight="220" minHeight="110">
                <columns>
                    <TableColumn fx:id="ledgerNumberColumn" text="#" prefWidth="40" sortable="false"/>
                    <TableColumn fx:id="ledgerTimeColumn" text="Time" prefWidth="80"/>
                    <TableColumn fx:id="ledgerDescriptionColumn" text="Description" prefWidth="320"/>
                    <TableColumn fx:id="ledgerAmountColumn" text="Amount" prefWidth="90"/>
                    <TableColumn fx:id="ledgerBalanceColumn" text="Balance after" prefWidth="100"/>
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                </columnResizePolicy>
                <placeholder>
                    <Label text="No account activity yet"/>
                </placeholder>
            </TableView>
        </VBox>
    </ScrollPane>
</SplitPane>

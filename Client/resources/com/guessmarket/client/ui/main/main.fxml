<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>

<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.guessmarket.client.ui.main.MainController">
    <!-- Header: app name, the logged-in user and balance, theme, log out -->
    <top>
        <HBox alignment="CENTER_LEFT" spacing="12" styleClass="header">
            <padding>
                <Insets top="8" right="12" bottom="8" left="12"/>
            </padding>
            <Label text="Guess Market" styleClass="title"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label fx:id="userLabel"/>
            <Label text="Theme:"/>
            <ComboBox fx:id="themeComboBox"/>
            <Button text="Log out" onAction="#onLogout"/>
        </HBox>
    </top>

    <!-- Each tab is its own FXML with its own controller; fx:id "events" injects eventsController -->
    <center>
        <TabPane tabClosingPolicy="UNAVAILABLE">
            <Tab text="Events">
                <content>
                    <fx:include fx:id="events" source="/com/guessmarket/client/ui/events/events.fxml"/>
                </content>
            </Tab>
            <Tab text="Account">
                <content>
                    <fx:include fx:id="account" source="/com/guessmarket/client/ui/account/account.fxml"/>
                </content>
            </Tab>
        </TabPane>
    </center>

    <!-- Status bar: short messages that should not interrupt the user -->
    <bottom>
        <HBox alignment="CENTER_LEFT" styleClass="status-bar">
            <padding>
                <Insets top="4" right="12" bottom="4" left="12"/>
            </padding>
            <Label fx:id="statusLabel"/>
        </HBox>
    </bottom>
</BorderPane>

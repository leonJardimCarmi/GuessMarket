<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>

<!-- minWidth / minHeight: the smallest size the screen is laid out at. In a smaller window it keeps this size
     and the window shows scroll bars (ClientContext puts every screen in a scroll pane). -->
<BorderPane minWidth="800" minHeight="550" xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.guessmarket.client.ui.main.MainController">
    <!-- Header: app name, the logged-in user and balance, theme, log out.
         minWidth="-Infinity" (USE_PREF_SIZE): never narrower than the text, so it is never cut to "..." -->
    <top>
        <BorderPane styleClass="header">
            <padding>
                <Insets top="8" right="12" bottom="8" left="12"/>
            </padding>
            <left>
                <Label text="Guess Market" styleClass="title" minWidth="-Infinity" BorderPane.alignment="CENTER_LEFT"/>
            </left>
            <!-- On the right; when the window is narrow, its parts move to more rows instead of being cut -->
            <center>
                <FlowPane alignment="CENTER_RIGHT" hgap="12" vgap="6">
                    <padding>
                        <Insets left="12"/>
                    </padding>
                    <Label fx:id="userLabel" styleClass="fact-value"/>
                    <Label fx:id="balanceLabel"/>
                    <HBox alignment="CENTER_LEFT" spacing="6">
                        <Label text="Theme:" minWidth="-Infinity"/>
                        <ComboBox fx:id="themeComboBox"/>
                    </HBox>
                    <Button text="Log out" minWidth="-Infinity" onAction="#onLogout"/>
                </FlowPane>
            </center>
        </BorderPane>
    </top>

    <!-- Each tab is its own FXML with its own controller; fx:id "events" injects eventsController -->
    <center>
        <TabPane fx:id="tabPane" tabClosingPolicy="UNAVAILABLE">
            <Tab text="Events">
                <content>
                    <fx:include fx:id="events" source="/com/guessmarket/client/ui/events/events.fxml"/>
                </content>
            </Tab>
            <Tab text="Account">
                <content>
                    <fx:include fx:id="account" source="/com/guessmarket/client/ui/account/account.fxml"/>
                </content>
            </Tab>
            <!-- Bonus. The title is bound in MainController: "Chat (2)" while messages wait unread -->
            <Tab fx:id="chatTab">
                <content>
                    <fx:include fx:id="chat" source="/com/guessmarket/client/ui/chat/chat.fxml"/>
                </content>
            </Tab>
        </TabPane>
    </center>

    <!-- Status bar: short messages that should not interrupt the user -->
    <bottom>
        <HBox alignment="CENTER_LEFT" styleClass="status-bar">
            <padding>
                <Insets top="4" right="12" bottom="4" left="12"/>
            </padding>
            <Label fx:id="statusLabel"/>
        </HBox>
    </bottom>
</BorderPane>

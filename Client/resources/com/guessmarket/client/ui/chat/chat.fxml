<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<!-- Bonus: the chat of all the logged-in users. -->
<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.guessmarket.client.ui.chat.ChatController">
    <padding>
        <Insets top="10" right="10" bottom="10" left="10"/>
    </padding>

    <top>
        <Label text="Chat - everyone who is logged in sees every message" styleClass="section-title">
            <BorderPane.margin>
                <Insets bottom="8"/>
            </BorderPane.margin>
        </Label>
    </top>

    <center>
        <ListView fx:id="messagesList">
            <placeholder>
                <Label text="No messages yet. Say hello!"/>
            </placeholder>
        </ListView>
    </center>

    <bottom>
        <VBox spacing="4">
            <padding>
                <Insets top="8"/>
            </padding>
            <HBox spacing="8" alignment="CENTER_LEFT">
                <TextField fx:id="messageField" promptText="Write a message and press Enter" HBox.hgrow="ALWAYS"
                           onAction="#onSend"/>
                <Button fx:id="sendButton" text="Send" minWidth="-Infinity" onAction="#onSend"/>
            </HBox>
            <Label fx:id="sendError" wrapText="true"/>
        </VBox>
    </bottom>
</BorderPane>
